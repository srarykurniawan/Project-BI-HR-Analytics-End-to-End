{
  "name": "HR Analytics - Nusantara",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#f0efec",
  "minimum": "#cde2fb",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#0b0b0b" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0b0b0b" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":  [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border":      [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 8 }],
        "dropShadow":  [{ "show": false }],
        "visualHeader":[{ "show": true }],
        "title":       [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#0b0b0b" } } }],
        "padding":     [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f4f5f7" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#f4f5f7" } } }]
      }
    },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#0b0b0b" } }, "fontSize": 24, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#52514e" } }, "fontSize": 10 }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "fontSize": 24, "fontColor": { "solid": { "color": "#0b0b0b" } } }],
        "label": [{ "fontSize": 10, "fontColor": { "solid": { "color": "#52514e" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "valueAxis":  [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "showAxisTitle": false }]
      }
    },
    "clusteredColumnChart": {
      "*": { "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } } }] }
    },
    "clusteredBarChart": {
      "*": { "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } } }] }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#52514e" } }, "textSize": 10 }],
        "items":  [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "textSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#f0efec" } }, "fontColor": { "solid": { "color": "#0b0b0b" } } }],
        "grid":          [{ "gridHorizontalColor": { "solid": { "color": "#e1e0d9" } } }]
      }
    }
  }
}
